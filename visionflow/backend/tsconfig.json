{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src", 
    "outDir": "dist",

    "lib": ["ESNext"],
    "types": ["node"],

    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true
  },
  "include": ["src"]
}